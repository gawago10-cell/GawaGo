<mxfile host="drawio" agent="GawaGo diagrams" version="24.7.17" pages="1"><diagram id="page-0" name="Data Flow Diagram (Level 1)"><mxGraphModel dx="6127" dy="3142" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="6127" pageHeight="3142" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="GawaGo Data Flow Diagram - Level 1" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="24.0" width="6047.0" height="34.0" as="geometry"/></mxCell><mxCell id="subtitle" value="The ten main processes of the platform, with every user and outside service drawn once. Data stores sit beside the process that uses them and repeat where two processes share one (the DFD duplicate convention). A superadmin can also do every administrator task." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="6047.0" height="40.0" as="geometry"/></mxCell><mxCell id="lg_p" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1F5F2;strokeColor=#0E8088;strokeWidth=2.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40.0" y="113.0" width="70.0" height="34.0" as="geometry"/></mxCell><mxCell id="lg_p_t" value="Process" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="119.0" width="59.0" height="22.0" as="geometry"/></mxCell><mxCell id="lg_e" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2D600;strokeColor=#B09500;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="203.0" y="115.0" width="60.0" height="30.0" as="geometry"/></mxCell><mxCell id="lg_e_t" value="User or outside service" st