// GawaGo database schema for dbdiagram.io
// Generated from the Django models in backend/apps on 2026-10-26.
// Matches docs/architecture/GawaGo_Database_Schema.drawio.

Project GawaGo {
  database_type: "PostgreSQL"
  Note: '''
    The 23 GawaGo application tables (generated from the Django models), followed
    by the Django framework tables they sit beside. Django-Q's task tables are left out.
    Analytics are computed from these tables; nothing is stored for them separately.
  '''
}

Table auth_user {
  id integer [pk, increment, not null]
  password varchar(128) [not null]
  last_login timestamp [null]
  is_superuser boolean [not null]
  username varchar(150) [unique, not null]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff boolean [not null]
  is_active boolean [not null]
  date_joined timestamp [not null]
}

Table accounts_workeravailability {
  id bigint [pk, increment, not null]
  worker_id integer [not null, ref: > auth_user.id]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  is_available boolean [not null]
}

Table accounts_passwordresetrequest {
  id bigint [pk, increment, not null]
  user_id integer [not null, ref: > auth_user.id]
  email varchar(254) [not null]
  token_hash varchar(128) [not null]
  created_at timestamp [not null]
  expires_at timestamp [not null]
  used_at timestamp [null]
  attempts integer [not null]
}

Table accounts_signupverificationrequest {
  id bigint [pk, increment, not null]
  user_id integer [unique, not null, ref: - auth_user.id]
  email varchar(254) [not null]
  token_hash varchar(128) [not null]
  created_at timestamp [not null]
  expires_at timestamp [not null]
  verified_at timestamp [null]
}

Table accounts_workerportfolio {
  id bigint [pk, increment, not null]
  worker_id integer [unique, not null, ref: - auth_user.id]
  bio text [not null]
  years_experience integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table accounts_workerportfolioitem {
  id bigint [pk, increment, not null]
  worker_id integer [not null, ref: > auth_user.id]
  title varchar(255) [not null]
  description text [not null]
  image varchar(100) [not null]
  before_image varchar(100) [null]
  after_image varchar(100) [null]
  created_at timestamp [not null]
}

Table accounts_workercertification {
  id bigint [pk, increment, not null]
  worker_id integer [not null, ref: > auth_user.id]
  certificate_type varchar(50) [not null, note: 'tesda, license, credential, certification, other']
  certificate_name varchar(255) [not null]
  issuer varchar(255) [not null]
  issue_date date [null]
  expiry_date date [null]
  certificate_file varchar(100) [null]
  is_verified boolean [not null]
  verification_status varchar(20) [not null, note: 'pending, approved, rejected']
  verified_by_id integer [null, ref: > auth_user.id]
  verification_notes text [not null]
  verified_at timestamp [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table accounts_userprofile {
  id bigint [pk, increment, not null]
  user_id integer [unique, not null, ref: - auth_user.id]
  role varchar(20) [not null, note: 'household, worker']
  phone varchar(30) [not null]
  bio text [not null]
  years_experience integer [not null]
  skills jsonb [not null]
  hourly_rate decimal(10,2) [null]
  daily_rate decimal(10,2) [null]
  verification_status varchar(20) [not null]
  primary_id_type varchar(50) [not null, note: 'national_id, passport, drivers_license, voter_id, tin, umid, postal_id, other']
  location_label varchar(255) [not null]
  latitude decimal(10,7) [null]
  longitude decimal(10,7) [null]
  profile_photo varchar(100) [null]
  average_rating decimal(3,2) [null]
  rating_count integer [not null]
  reputation_tier varchar(20) [not null, note: 'new, established, trusted, elite']
  rating_trend varchar(20) [not null, note: 'improving, declining, neutral']
  credentials_updated_at timestamp [null]
  is_blocked boolean [not null]
  blocked_at timestamp [null]
  blocked_reason text [not null]
  blocked_until timestamp [null]
}

Table accounts_workerskill {
  id bigint [pk, increment, not null]
  worker_id integer [not null, ref: > auth_user.id]
  skill_name varchar(120) [not null]
  proficiency varchar(20) [not null, note: 'beginner, intermediate, expert']
  average_rating decimal(3,2) [null]
  rating_count integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (worker_id, skill_name) [unique]
  }
}

Table accounts_skillrating {
  id bigint [pk, increment, not null]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  household_id integer [not null, ref: > auth_user.id]
  worker_id integer [not null, ref: > auth_user.id]
  skill_id bigint [not null, ref: > accounts_workerskill.id]
  rating decimal(2,1) [not null]
  feedback text [not null]
  created_at timestamp [not null]

  indexes {
    (job_id, household_id, worker_id, skill_id) [unique]
  }
}

Table jobs_jobposting {
  id bigint [pk, increment, not null]
  household_id integer [not null, ref: > auth_user.id]
  title varchar(255) [not null]
  job_type varchar(120) [not null]
  required_skill varchar(120) [not null]
  schedule varchar(255) [not null]
  schedule_type varchar(80) [not null]
  description text [not null]
  location_label varchar(255) [not null]
  latitude decimal(10,7) [not null]
  longitude decimal(10,7) [not null]
  service_rate decimal(10,2) [not null]
  rate_type varchar(20) [not null, note: 'per_day, per_hour, fixed']
  worker_slots integer [not null]
  status varchar(20) [not null, note: 'open, assigned, completion_requested, completed, cancelled']
  job_start_date date [null]
  job_end_date date [null]
  estimated_working_days integer [null]
  max_distance_km double_precision [not null]
  geographic_boundary varchar(20) [not null, note: '1km, 2km, 5km, 10km, unlimited']
  created_at timestamp [not null]
  completed_at timestamp [null]
}

Table jobs_jobimage {
  id bigint [pk, increment, not null]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  image varchar(100) [not null]
  uploaded_at timestamp [not null]
  order integer [not null]
}

Table jobs_jobapplication {
  id bigint [pk, increment, not null]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  worker_id integer [not null, ref: > auth_user.id]
  status varchar(20) [not null, note: 'pending, hire_requested, hired, rejected, closed, completed']
  applied_at timestamp [not null]
  updated_at timestamp [not null]
  note text [not null]

  indexes {
    (job_id, worker_id) [unique]
  }
}

Table jobs_jobstatusevent {
  id bigint [pk, increment, not null]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  application_id bigint [null, ref: > jobs_jobapplication.id]
  entity varchar(20) [not null, note: 'job, application']
  from_status varchar(20) [not null]
  to_status varchar(20) [not null]
  actor_id integer [null, ref: > auth_user.id]
  note varchar(255) [not null]
  created_at timestamp [not null]
}

Table matching_routedistancecache {
  id bigint [pk, increment, not null]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  worker_profile_id bigint [not null, ref: > accounts_userprofile.id]
  job_latitude decimal(10,7) [not null]
  job_longitude decimal(10,7) [not null]
  worker_latitude decimal(10,7) [not null]
  worker_longitude decimal(10,7) [not null]
  distance_km decimal(10,3) [not null]
  route_points jsonb [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table reviews_review {
  id bigint [pk, increment, not null]
  author_id integer [null, ref: > auth_user.id]
  author_username varchar(150) [not null]
  target_id integer [not null, ref: > auth_user.id]
  author_role varchar(20) [not null, note: 'household, worker']
  target_role varchar(20) [not null, note: 'household, worker']
  job_id bigint [null, ref: > jobs_jobposting.id]
  job_title varchar(255) [not null]
  rating decimal(2,1) [null]
  feedback text [not null]
  quality_of_work integer [null, note: '1, 2, 3, 4, 5']
  punctuality integer [null, note: '1, 2, 3, 4, 5']
  communication integer [null, note: '1, 2, 3, 4, 5']
  professionalism integer [null, note: '1, 2, 3, 4, 5']
  created_at timestamp [not null]
  is_system_generated boolean [not null]
}

Table notifications_notification {
  id bigint [pk, increment, not null]
  recipient_id integer [not null, ref: > auth_user.id]
  actor_id integer [null, ref: > auth_user.id]
  notification_type varchar(30) [not null, note: 'application, account_activity, accepted, hiring, rejection, verification, analytics, completion, review_reminder, job_match, review, admin_alert']
  title varchar(255) [not null]
  message text [not null]
  related_job_id integer [null]
  related_application_id integer [null]
  action_type varchar(40) [not null, note: ', hire_request, job_detail, review']
  action_url varchar(255) [not null]
  requires_action boolean [not null]
  is_read boolean [not null]
  created_at timestamp [not null]
}

Table common_verificationrequest {
  id bigint [pk, increment, not null]
  worker_id integer [not null, ref: > auth_user.id]
  primary_id_type varchar(50) [not null, note: 'national_id, passport, drivers_license, voter_id, tin, umid, postal_id, other']
  primary_id_name varchar(255) [not null]
  secondary_doc_name varchar(255) [not null]
  primary_id_file varchar(100) [null]
  secondary_doc_file varchar(100) [null]
  notes text [not null]
  status varchar(20) [not null, note: 'pending, approved, rejected']
  submitted_at timestamp [not null]
  reviewed_at timestamp [null]
  review_note text [not null]
}

Table common_adminactionlog {
  id bigint [pk, increment, not null]
  actor_id integer [null, ref: > auth_user.id]
  actor_username varchar(150) [not null]
  action varchar(40) [not null, note: 'user_suspended, user_restored, complaint_status_changed, complaint_respondent_blocked, verification_approved, verification_rejected, certificate_approved, certificate_rejected, job_updated, job_deleted, admin_created, admin_deactivated']
  target_label varchar(255) [not null]
  target_type varchar(40) [not null]
  target_id integer [null]
  detail text [not null]
  created_at timestamp [not null]
}

Table common_revokedtoken {
  id bigint [pk, increment, not null]
  jti varchar(64) [unique, not null]
  user_id integer [not null, ref: > auth_user.id]
  expires_at timestamp [not null]
  revoked_at timestamp [not null]
}

Table complaints_complaint {
  id bigint [pk, increment, not null]
  complainant_id integer [null, ref: > auth_user.id]
  complainant_username varchar(150) [not null]
  respondent_id integer [null, ref: > auth_user.id]
  respondent_username varchar(150) [not null]
  job_id bigint [null, ref: > jobs_jobposting.id]
  complaint_type varchar(50) [not null, note: 'payment_issue, quality_of_work, no_show, safety_concern, behavior, other']
  description text [not null]
  status varchar(20) [not null, note: 'submitted, under_review, resolved, closed']
  resolution text [null]
  admin_notes text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table complaints_complaintevidence {
  id bigint [pk, increment, not null]
  complaint_id bigint [not null, ref: > complaints_complaint.id]
  image varchar(100) [not null]
  uploaded_at timestamp [not null]
  order integer [not null]
}

Table chat_message {
  id bigint [pk, increment, not null]
  application_id bigint [not null, ref: > jobs_jobapplication.id]
  sender_id integer [not null, ref: > auth_user.id]
  content text [not null]
  created_at timestamp [not null]
  is_read boolean [not null]
}

// ---------------------------------------------------------------
// Django framework tables (unchanged by GawaGo)

Table django_content_type {
  id int [pk, increment]
  app_label varchar(100) [not null]
  model varchar(100) [not null]

  indexes {
    (app_label, model) [unique]
  }
}

Table auth_permission {
  id int [pk, increment]
  name varchar(255) [not null]
  content_type_id int [not null, ref: > django_content_type.id]
  codename varchar(100) [not null]

  indexes {
    (content_type_id, codename) [unique]
  }
}

Table auth_group {
  id int [pk, increment]
  name varchar(150) [not null, unique]
}

Table auth_group_permissions {
  id bigint [pk, increment]
  group_id int [not null, ref: > auth_group.id]
  permission_id int [not null, ref: > auth_permission.id]

  indexes {
    (group_id, permission_id) [unique]
  }
}

Table auth_user_groups {
  id bigint [pk, increment]
  user_id int [not null, ref: > auth_user.id]
  group_id int [not null, ref: > auth_group.id]

  indexes {
    (user_id, group_id) [unique]
  }
}

Table auth_user_user_permissions {
  id bigint [pk, increment]
  user_id int [not null, ref: > auth_user.id]
  permission_id int [not null, ref: > auth_permission.id]

  indexes {
    (user_id, permission_id) [unique]
  }
}

Table django_admin_log {
  id int [pk, increment]
  action_time datetime [not null]
  object_id text
  object_repr varchar(200) [not null]
  action_flag smallint [not null]
  change_message text [not null]
  content_type_id int [ref: > django_content_type.id]
  user_id int [not null, ref: > auth_user.id]
}
