// GawaGo current database schema for dbdiagram.io
// Source of truth: Django models in backend/apps plus Django auth/admin/session tables.
// Generated from code review on 2026-06-19.

Project GawaGo {
  database_type: "MySQL"
  Note: '''
    This DBML follows the current Django backend models.
    Analytics are computed from operational tables and do not currently have
    dedicated persisted analytics models.
  '''
}

Table django_content_type {
  id int [pk, increment]
  app_label varchar(100) [not null]
  model varchar(100) [not null]

  indexes {
    (app_label, model) [unique]
  }
}

Table auth_permission {
  id int [pk, increment]
  name varchar(255) [not null]
  content_type_id int [not null, ref: > django_content_type.id]
  codename varchar(100) [not null]

  indexes {
    (content_type_id, codename) [unique]
  }
}

Table auth_group {
  id int [pk, increment]
  name varchar(150) [not null, unique]
}

Table auth_group_permissions {
  id bigint [pk, increment]
  group_id int [not null, ref: > auth_group.id]
  permission_id int [not null, ref: > auth_permission.id]

  indexes {
    (group_id, permission_id) [unique]
  }
}

Table auth_user {
  id int [pk, increment]
  password varchar(128) [not null]
  last_login datetime
  is_superuser boolean [not null]
  username varchar(150) [not null, unique]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff boolean [not null]
  is_active boolean [not null]
  date_joined datetime [not null]
}

Table auth_user_groups {
  id bigint [pk, increment]
  user_id int [not null, ref: > auth_user.id]
  group_id int [not null, ref: > auth_group.id]

  indexes {
    (user_id, group_id) [unique]
  }
}

Table auth_user_user_permissions {
  id bigint [pk, increment]
  user_id int [not null, ref: > auth_user.id]
  permission_id int [not null, ref: > auth_permission.id]

  indexes {
    (user_id, permission_id) [unique]
  }
}

Table django_admin_log {
  id int [pk, increment]
  action_time datetime [not null]
  object_id text
  object_repr varchar(200) [not null]
  action_flag smallint [not null]
  change_message text [not null]
  content_type_id int [ref: > django_content_type.id]
  user_id int [not null, ref: > auth_user.id]
}

Table accounts_userprofile {
  id bigint [pk, increment]
  user_id int [not null, unique, ref: - auth_user.id, note: "One profile per Django user."]
  role varchar(20) [not null, note: "household, worker"]
  phone varchar(30) [not null]
  bio text [not null]
  years_experience int [not null]
  skills json [not null, note: "Worker skill list used by smart matching."]
  hourly_rate decimal(10,2)
  daily_rate decimal(10,2)
  verification_status varchar(20) [not null, note: "pending, approved, rejected"]
  location_label varchar(255) [not null]
  latitude decimal(10,7)
  longitude decimal(10,7)
  profile_photo varchar(100)
  average_rating decimal(3,2)
  rating_count int [not null]
}

Table accounts_workeravailability {
  id bigint [pk, increment]
  worker_id int [not null, ref: > auth_user.id]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  is_available boolean [not null]

  indexes {
    (worker_id, date, start_time, end_time) [unique]
  }
}

Table accounts_workerweeklyavailability {
  id bigint [pk, increment]
  worker_id int [not null, ref: > auth_user.id]
  weekday smallint [not null, note: "0=Monday through 6=Sunday."]
  start_time time [not null]
  end_time time [not null]
  is_available boolean [not null]

  indexes {
    (worker_id, weekday, start_time, end_time) [unique]
  }

  Note: "Django also enforces weekday between 0 and 6 with a check constraint."
}

Table accounts_passwordresetrequest {
  id bigint [pk, increment]
  user_id int [not null, ref: > auth_user.id]
  email varchar(254) [not null]
  token_hash varchar(128) [not null]
  created_at datetime [not null]
  expires_at datetime [not null]
  used_at datetime
  attempts int [not null]

  indexes {
    (email, created_at)
  }
}

Table accounts_signupverificationrequest {
  id bigint [pk, increment]
  user_id int [not null, unique, ref: - auth_user.id]
  email varchar(254) [not null]
  token_hash varchar(128) [not null]
  created_at datetime [not null]
  expires_at datetime [not null]
  verified_at datetime
}

Table jobs_jobposting {
  id bigint [pk, increment]
  household_id int [not null, ref: > auth_user.id, note: "The user who posted the household job."]
  title varchar(255) [not null]
  job_type varchar(120) [not null]
  required_skill varchar(120) [not null]
  schedule varchar(255) [not null]
  schedule_type varchar(80) [not null]
  preferred_date date
  preferred_time time
  description text [not null]
  location_label varchar(255) [not null]
  latitude decimal(10,7) [not null]
  longitude decimal(10,7) [not null]
  service_rate decimal(10,2) [not null]
  worker_slots int [not null]
  status varchar(20) [not null, note: "open, assigned, completion_requested, completed, cancelled"]
  created_at datetime [not null]
  completed_at datetime
}

Table jobs_jobimage {
  id bigint [pk, increment]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  image varchar(100) [not null]
  uploaded_at datetime [not null]
  order int [not null]
}

Table jobs_jobapplication {
  id bigint [pk, increment]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  worker_id int [not null, ref: > auth_user.id, note: "The worker applying for or hired into the job."]
  status varchar(20) [not null, note: "pending, hire_requested, hired, rejected, closed, completed"]
  applied_at datetime [not null]
  updated_at datetime [not null]
  note text [not null]

  indexes {
    (job_id, worker_id) [unique]
  }
}

Table reviews_review {
  id bigint [pk, increment]
  author_id int [not null, ref: > auth_user.id]
  target_id int [not null, ref: > auth_user.id]
  author_role varchar(20) [not null, note: "household, worker"]
  target_role varchar(20) [not null, note: "household, worker"]
  job_id bigint [ref: > jobs_jobposting.id]
  job_title varchar(255) [not null]
  rating decimal(2,1)
  feedback text [not null]
  created_at datetime [not null]

  indexes {
    (job_id, author_id, target_id) [name: "unique_household_worker_review_per_job_logical"]
    (job_id, author_id, target_id) [name: "unique_worker_household_review_per_job_logical"]
  }

  Note: '''
    Django enforces two conditional unique constraints:
    one household-to-worker review per job, and one worker-to-household review per job.
    Rating is nullable to support feedback workflows and default/no-feedback policy handling.
  '''
}

Table notifications_notification {
  id bigint [pk, increment]
  recipient_id int [not null, ref: > auth_user.id]
  actor_id int [ref: > auth_user.id, note: "Nullable; set to null if the actor user is deleted."]
  notification_type varchar(30) [not null, note: "application, account_activity, accepted, hiring, rejection, verification, analytics, completion, review_reminder, job_match"]
  title varchar(255) [not null]
  message text [not null]
  related_job_id int [note: "Logical reference to jobs_jobposting.id; stored as PositiveIntegerField, not a database FK."]
  related_application_id int [note: "Logical reference to jobs_jobapplication.id; stored as PositiveIntegerField, not a database FK."]
  action_type varchar(40) [not null, note: "none, hire_request, job_detail, review"]
  action_url varchar(255) [not null]
  requires_action boolean [not null]
  is_read boolean [not null]
  created_at datetime [not null]
}

Table common_verificationrequest {
  id bigint [pk, increment]
  worker_id int [not null, ref: > auth_user.id]
  primary_id_name varchar(255) [not null]
  secondary_doc_name varchar(255) [not null]
  primary_id_file varchar(100)
  secondary_doc_file varchar(100)
  notes text [not null]
  status varchar(20) [not null, note: "pending, approved, rejected"]
  submitted_at datetime [not null]
  reviewed_at datetime
  review_note text [not null]
}

Table matching_routedistancecache {
  id bigint [pk, increment]
  job_id bigint [not null, ref: > jobs_jobposting.id]
  worker_profile_id bigint [not null, ref: > accounts_userprofile.id]
  job_latitude decimal(10,7) [not null]
  job_longitude decimal(10,7) [not null]
  worker_latitude decimal(10,7) [not null]
  worker_longitude decimal(10,7) [not null]
  distance_km decimal(10,3) [not null]
  route_points json [not null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (job_id, worker_profile_id) [unique]
  }
}

TableGroup "Django platform tables" {
  django_content_type
  auth_permission
  auth_group
  auth_group_permissions
  auth_user
  auth_user_groups
  auth_user_user_permissions
  django_admin_log
}

TableGroup "GawaGo business tables" {
  accounts_userprofile
  accounts_workeravailability
  accounts_workerweeklyavailability
  accounts_passwordresetrequest
  accounts_signupverificationrequest
  jobs_jobposting
  jobs_jobimage
  jobs_jobapplication
  reviews_review
  notifications_notification
  common_verificationrequest
  matching_routedistancecache
}

// Logical notification links intentionally are not drawn as FK relationships:
// notifications_notification.related_job_id and related_application_id are plain
// PositiveIntegerField values in Django, while JobPosting and JobApplication use BigAutoField IDs.
