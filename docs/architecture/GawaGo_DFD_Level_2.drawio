<mxfile host="drawio" agent="GawaGo diagrams" version="24.7.17" pages="1"><diagram id="page-0" name="Data Flow Diagram (Level 2)"><mxGraphModel dx="4451" dy="4318" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4451" pageHeight="4318" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="GawaGo Data Flow Diagram - Level 2" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="24.0" width="4371.0" height="34.0" as="geometry"/></mxCell><mxCell id="subtitle" value="Each dashed box is one Level 1 process broken down into its sub-processes. The thick blue arrows hand data from one sub-process to the next, so the whole platform reads as one flow from sign-up to reports. Users, services and data stores repeat in each row (the DFD duplicate convention) so no lines cross. A superadmin can also do every administrator task." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="4371.0" height="40.0" as="geometry"/></mxCell><mxCell id="lg_p" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40.0" y="112.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="lg_p_t" value="Process" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84.0" y="120.0" width="200.0" height="20.0" as="geometry"/></mxCell><mxCell id="lg_e" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="165.0" y="116.0" width="56.0" height="28.