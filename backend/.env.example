# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Local Development Mode
# Set to True to use SQLite and console email while testing locally.
DJANGO_USE_SQLITE_FOR_DEV=True
DJANGO_USE_CONSOLE_EMAIL=True

# Database Configuration
# DJANGO_DB_ENGINE selects which database to use when
# DJANGO_USE_SQLITE_FOR_DEV=False -- one of: mysql, postgresql (default).
# For mysql, also install requirements-mysql.txt: the MySQL driver is not in
# requirements.txt because it needs system headers PostgreSQL hosts lack.
DJANGO_DB_ENGINE=postgresql
DJANGO_MYSQL_DRIVER=auto
DB_NAME=gawago
DB_USER=gawago_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
# 3306 for mysql, 5432 for postgresql
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Production Security
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Email / Password Reset
# Two ways to send. Brevo's SMTP relay only accepts IPs on the account's
# authorised list (otherwise: 525 Unauthorized IP address), which is awkward
# where residential IPs are dynamic -- a router reboot stops reset codes
# going out. The HTTP API below has no such list and uses port 443, which
# networks that block outbound SMTP still allow.
#
# A) Brevo HTTP API (recommended) -- key from Brevo > SMTP & API > "API keys"
# EMAIL_BACKEND=apps.common.email_backends.BrevoAPIEmailBackend
# BREVO_API_KEY=your_brevo_api_key
#
# B) SMTP (any provider). For Brevo, EMAIL_HOST_USER is the "Login" shown on
#    its SMTP page and EMAIL_HOST_PASSWORD is an SMTP key, not your password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
# Must be a sender address verified with your provider.
DEFAULT_FROM_EMAIL=your_gmail_address@gmail.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=10

# Road-route distance for backend smart matching
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key
OPENROUTESERVICE_DIRECTIONS_URL=https://api.openrouteservice.org/v2/directions/driving-car/geojson
OPENROUTESERVICE_TIMEOUT_SECONDS=4
# Used as the driving-route fallback when OPENROUTESERVICE_API_KEY is empty,
# and when it is set but fails (quota spent, expired key, outage).
OSRM_DIRECTIONS_URL=https://router.project-osrm.org/route/v1/driving

# Cloudinary for PUBLIC uploads only: profile photos, job images, portfolio
# work samples. Government IDs, worker certificates and complaint evidence
# always stay on local disk behind permission-checked views, whatever this is
# set to -- a Cloudinary delivery URL is public to anyone who has it.
#
# Leave False on a host with a persistent disk. Set True on a host with an
# ephemeral filesystem (Render/Railway free tier), where uploads would
# otherwise disappear on every redeploy. With True the credentials below are
# required or the app refuses to start.
#
# THIS FILE IS COMMITTED -- keep placeholders here and put real values in
# backend/.env, which is gitignored.
#
# Easiest: paste the combined credential from the Cloudinary dashboard
# ("API environment variable", which has a copy button):
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Use the copy button rather than retyping -- the dashboard renders capital I
# and lowercase l identically, so a hand-copied secret tends to fail with
# "Invalid Signature". The three separate values below work too.

USE_CLOUDINARY=False
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_USE_SQLITE_FOR_DEV=True
DJANGO_MYSQL_DRIVER=auto

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourrealgmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=yourrealgmail@gmail.com
