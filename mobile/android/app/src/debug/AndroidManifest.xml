<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Cleartext HTTP only for debug builds, which talk to a local dev
         server (e.g. http://10.0.2.2) with no TLS available. Deliberately
         not in the main manifest: a release build must only ever reach the
         production API over HTTPS (F-15). -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
